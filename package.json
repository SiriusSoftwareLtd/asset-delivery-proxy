{
	"name": "asset-delivery-proxy",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "cross-env X_LOCAL_OBSERVABILITY=true wrangler dev",
		"start": "wrangler dev",
		"test": "vitest run",
		"test:assets": "cross-env ASSET_TEST_MATRIX=1 vitest run test/assets.spec.ts test/assetResilience.spec.ts",
		"test:assets:verbose": "cross-env ASSET_TEST_MATRIX=1 vitest run test/assets.spec.ts test/assetResilience.spec.ts --reporter=verbose",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit && tsc --noEmit --project test/tsconfig.json",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"lint": "biome check .",
		"lint:fix": "biome check --write",
		"format": "biome format .",
		"format:fix": "biome format --write",
		"verify:production": "tsx scripts/verify-production.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@cloudflare/vitest-pool-workers": "^0.12.21",
		"@types/node": "^26.1.1",
		"@vitest/coverage-istanbul": "3.2.7",
		"cross-env": "^10.1.0",
		"tsx": "^4.23.5",
		"typescript": "^5.5.2",
		"vitest": "~3.2.0",
		"wrangler": "^4.114.0"
	},
	"dependencies": {
		"@resvg/resvg-wasm": "^2.6.2",
		"hono": "^4.12.32"
	},
	"packageManager": "pnpm@11.18.0"
}

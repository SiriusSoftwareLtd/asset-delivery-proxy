{
	"name": "asset-delivery-proxy",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "cross-env X_LOCAL_OBSERVABILITY=true wrangler dev",
		"start": "wrangler dev",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit --project test/tsconfig.json",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"lint": "biome check .",
		"lint:fix": "biome check --write",
		"format": "biome format .",
		"format:fix": "biome format --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@cloudflare/vitest-pool-workers": "^0.12.21",
		"@types/node": "^26.1.1",
		"cross-env": "^10.1.0",
		"typescript": "^5.5.2",
		"vitest": "~3.2.0",
		"wrangler": "^4.114.0"
	},
	"dependencies": {
		"@resvg/resvg-wasm": "^2.6.2",
		"hono": "^4.12.32"
	},
	"packageManager": "pnpm@11.17.0"
}

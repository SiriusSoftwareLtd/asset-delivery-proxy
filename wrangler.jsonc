/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gen2-asset-delivery-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-03",
	"compatibility_flags": ["nodejs_compat"],
	"kv_namespaces": [
		{
			"binding": "assetCache",
			"id": "45592b2aefe14f9db19167adda87cbda",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ASSET_RESOLUTION_COORDINATOR",
				"class_name": "AssetResolutionCoordinator",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AssetResolutionCoordinator"],
		},
	],
	"analytics_engine_datasets": [
		{
			"binding": "ASSET_METRICS",
			"dataset": "asset_delivery_metrics",
		},
	],
	"ratelimits": [
		{
			"name": "ASSET_PROXY_RATE_LIMITER",
			"namespace_id": "2000",
			"simple": {
				"limit": 100,
				"period": 60,
			},
		},
	],
	"rules": [
		{
			"type": "CompiledWasm",
			"globs": ["**/*.wasm"],
			"fallthrough": true,
		},
	],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05,
		},
	},
	"vars": {
		"OBSERVABILITY_REPORT_LEVEL": "off",
		"ASSET_COORDINATOR_BUDGET_VERIFIED": "false",
		"ASSET_COORDINATOR_SHARDS": "16",
		"ASSET_COORDINATOR_CONCURRENCY": "1",
		"ASSET_COORDINATOR_QUEUE_LIMIT": "32",
		"ASSET_COORDINATOR_PERMIT_INTERVAL_MS": "1000",
		"ASSET_COORDINATOR_FALLBACK_COOLDOWN_SECONDS": "30",
		"ASSET_COORDINATOR_OPERATION_DEADLINE_MS": "25000",
		"ASSET_COORDINATOR_RETRY_BASE_MS": "250",
		"ASSET_LEGACY_V1_READ_UNTIL": "2026-09-01T00:00:00.000Z",
	},
	"secrets": {
		"required": ["ROBLOX_API_KEY"],
	},
	"upload_source_maps": true,
	"flagship": [
		{
			"binding": "FLAGS",
			"app_id": "5204f93d-416a-4374-aefa-a6227b8876f1",
		},
	],
}
